# Environment Configuration Example
# Copy this file to .env and update the values
# See SETUP.md for complete installation and setup instructions

# Application Configuration
NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# Database Configuration (PostgreSQL 16)
# Note: This requires PostgreSQL to be installed and running locally.
# See SETUP.md for installation instructions.
# Update the password to match your PostgreSQL installation.
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/project_management?schema=public

# Authentication & Sessions
SESSION_SECRET=supersecret-session-key-change-in-production-min-32-chars
COOKIE_SECURE=false

# Email Configuration (Leave empty to use Dev Mailbox Preview at /api/v1/dev/emails)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=notifications@projectmgmt.local
