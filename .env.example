# Environment Configuration Example
# Copy this file to .env and update the values
# See SETUP.md for complete installation and setup instructions

# Application Configuration
NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# Database Configuration (PostgreSQL 16)
# Note: This requires PostgreSQL to be installed and running locally.
# See SETUP.md for installation instructions.
# Update the password to match your PostgreSQL installation.
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/project_management?schema=public

# Authentication & Sessions
SESSION_SECRET=supersecret-session-key-change-in-production-min-32-chars
COOKIE_SECURE=false

# Email Configuration
# Leave SMTP_HOST empty to use Dev Mailbox Preview at /api/v1/dev/emails (development only)
# For production, configure a real SMTP server for email delivery
#
# Common SMTP Providers:
# - Gmail: smtp.gmail.com, port 587 (requires App Password if 2FA enabled)
# - SendGrid: smtp.sendgrid.net, port 587 or 2525
# - Mailgun: smtp.mailgun.org, port 587 or 2525
# - AWS SES: email-smtp.{region}.awsamazon.com, port 587
# - Outlook/Office365: smtp.office365.com, port 587
#
# TLS Configuration:
# - Port 465: Use secure=true (implicit TLS/SSL)
# - Port 587: Use secure=false (STARTTLS)
# - Port 25: Use secure=false (no encryption, not recommended)
#
# How to obtain SMTP credentials:
# 1. Sign up with an email service provider (SendGrid, Mailgun, AWS SES, etc.)
# 2. Create an SMTP user/password in their dashboard
# 3. Configure the host, port, and credentials below
# 4. Set SMTP_FROM to a verified sender email address
#
# Example for SendGrid:
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASS=SG.xxxxx.yyyyy
# SMTP_FROM=noreply@yourdomain.com
#
# Example for Gmail (requires App Password):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
# SMTP_FROM=your-email@gmail.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=notifications@projectmgmt.local
